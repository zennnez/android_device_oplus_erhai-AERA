# Charger
ro.charger.enable_suspend=true

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# UI & Touch orientation (Tablet portrait)
persist.recovery.ui.rotation=270
persist.recovery.touch.swap_xy=1
persist.recovery.touch.flip_y=1

# USB / ADB
ro.recovery.usb.vid=18D1
ro.recovery.usb.adb.pid=D001
ro.recovery.usb.fastboot.pid=4EE0
