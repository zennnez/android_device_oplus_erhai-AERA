#!/bin/sh
# =============================================================================
# setup_partitions — Android / Linux disk partitioning utility for erhai
# Based on setup_erhai_partitions.sh v1.2 by TheMojoMan
# Can be run interactively in recovery terminal or headless with CLI flags.
# =============================================================================

DRY_RUN=1
MODE=""
DEV_MODE=0
USERDATA_GB=64
LINUX_GB=40
DATA_GB="all"
ESP_SIZE_MB=300
FORMAT_USERDATA=1

DISK=""
BYNAME=""
SECSZ=4096
UD_NUM=""
UD_START=""
UD_END=""
LAST_USABLE=""

# Where the by-name links live differs between TWRP builds, and a link can
# already exist while its device node does not (a dangling link makes `-e`
# false and `-L` true). The search prefers the directory that exposes userdata,
# and keeps the first existing one as the fallback.
BYNAME_DIRS="${ERHAI_BYNAME_DIRS:-/dev/block/by-name /dev/block/bootdevice/by-name /dev/block/platform/soc/*/by-name /dev/block/platform/*/by-name}"

say()  { echo "$@"; }
die()  { echo ""; echo "!! ERROR: $1" >&2; echo "!! ABORTED." >&2; exit 1; }

confirm() {
	printf "%s [y/n, default N]: " "$1"
	read -r _ans
	[ "$_ans" = "y" ] || [ "$_ans" = "Y" ]
}

have_node()   { [ -e "$1" ] || [ -L "$1" ]; }
usable_node() { [ -b "$(readlink -f "$1" 2>/dev/null)" ]; }

is_whole_disk() {
	[ -d "/sys/block/$(basename "$1")" ] || return 1
	[ ! -e "/sys/block/$(basename "$1")/partition" ]
}

disk_of_node() {
	_n=$(readlink -f "$1" 2>/dev/null)
	_b=$(echo "$_n" | sed -e 's/[0-9][0-9]*$//')
	case "$_b" in
		*p) DISK=${_b%p} ;;
		*)  DISK=$_b ;;
	esac
}

find_disk() {
	_fb=""
	for d in $BYNAME_DIRS; do
		[ -d "$d" ] || continue
		[ -n "$_fb" ] || _fb="$d"
		if usable_node "$d/userdata"; then BYNAME="$d"; break; fi
	done
	[ -n "$BYNAME" ] || BYNAME="$_fb"
	[ -n "$BYNAME" ] || die "No by-name partition directory found. Are you in TWRP?"

	UD=""
	if usable_node "$BYNAME/userdata"; then
		UD=$(readlink -f "$BYNAME/userdata")
		UD_NUM=$(echo "$UD" | sed -e 's/.*[^0-9]\([0-9][0-9]*\)$/\1/')
		disk_of_node "$BYNAME/userdata"
	elif have_node "$BYNAME/userdata"; then
		say " !! '$BYNAME/userdata' points at a device node that is not there yet."
		say " !! (triggering mdev/uevents...)"
		mdev -s >/dev/null 2>&1 || true
	fi

	if [ -z "$DISK" ]; then
		# No usable userdata — work the disk out from ANY other by-name entry,
		# so the tool still runs on a tablet whose Android data was removed.
		for _p in super boot_a boot_b boot system vendor persist metadata vbmeta_a; do
			if usable_node "$BYNAME/$_p"; then disk_of_node "$BYNAME/$_p"; break; fi
		done
	fi

	if [ -z "$DISK" ]; then
		# Last resort: scan the whole block devices for a GPT that carries a
		# 'userdata' partition; if none does, remember the first real GPT.
		_scanned=""
		for _d in /dev/block/sd* /dev/block/vd* /dev/block/mmcblk* /dev/block/nvme*n1; do
			is_whole_disk "$_d" || continue
			_t=$(sgdisk --print "$_d" 2>/dev/null)
			case "$_t" in
				*userdata*) DISK="$_d"; break ;;
				*"Partition table holds"*) [ -n "$_scanned" ] || _scanned="$_d" ;;
			esac
		done
		[ -n "$DISK" ] || DISK="$_scanned"
	fi

	if [ -z "$DISK" ] || [ ! -b "$DISK" ]; then
		say ""
		say "by-name directory : $BYNAME"
		ls -l "$BYNAME" 2>/dev/null | head -40
		die "Cannot work out the disk that holds the partitions (guessed '$DISK')."
	fi

	SECSZ=$(blockdev --getss "$DISK" 2>/dev/null)
	[ -n "$SECSZ" ] || SECSZ=4096

	load_table
}

TABLE=""
load_table() {
	TABLE=$(sgdisk --print "$DISK" 2>/dev/null)
}

table_rows() {
	printf '%s\n' "$TABLE" | awk '
		$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ { print $1, $2, $3 }'
}

part_num_by_name() {
	printf '%s\n' "$TABLE" | awk -v n="$1" '
		$1 ~ /^[0-9]+$/ && tolower($NF) == tolower(n) { print $1; exit }'
}

part_first_sector() {
	table_rows | awk -v p="$1" '$1+0 == p+0 { print $2; exit }'
}

part_last_sector() {
	table_rows | awk -v p="$1" '$1+0 == p+0 { print $3; exit }'
}

last_usable_sector() {
	printf '%s\n' "$TABLE" | awk '/last usable sector/ { print $NF; exit }'
}

first_usable_sector() {
	printf '%s\n' "$TABLE" | awk '/First usable sector/ { print $5+0; exit }'
}

part_name_by_num_excl() {
	printf '%s\n' "$TABLE" | awk -v p="$1" -v del="$2" '
		BEGIN { nd = split(del, D, " "); for (i = 1; i <= nd; i++) skip[D[i]] = 1 }
		$1 ~ /^[0-9]+$/ && $1+0 == p+0 {
			if ($1 in skip) exit
			if ($7 != "") print $7
			exit
		}'
}

gpt_max_entries() {
	printf '%s\n' "$TABLE" | awk '/Partition table holds up to/ { print $6; exit }'
}

next_slot() {
	_max=$(gpt_max_entries)
	[ -n "$_max" ] || _max=128
	_n=$(($2 + 1))
	while :; do
		[ "$_n" -le "$_max" ] || die \
			"no free partition number left (GPT holds only $_max entries)."
		if [ -z "$(part_name_by_num_excl "$_n" "$1")" ]; then
			echo "$_n"
			return
		fi
		_n=$((_n + 1))
	done
}

lowest_free_num() {
	table_rows | awk -v del="$1" '
		BEGIN { nd = split(del, D, " "); for (i = 1; i <= nd; i++) free[D[i]] = 1; n = 1 }
		{ if ($1 in free) next; used[$1] = 1 }
		END { while (n in used) n++; print n }'
}

next_start_after() {
	table_rows | awk -v me="$1" -v del="$2" -v after="$3" '
		BEGIN { nd = split(del, D, " "); for (i = 1; i <= nd; i++) skip[D[i]] = 1; best = 0 }
		{
			if ($1 == me || ($1 in skip)) next
			s = $2 + 0
			if (s > after + 0 && (best == 0 || s < best)) best = s
		}
		END { print best }'
}

plan_gap() {
	table_rows | sort -k2,2n | awk -v del="$1" -v ud="$2" -v act="$3" -v udend="$4" \
		-v first="$5" -v last="$6" '
		BEGIN {
			nd = split(del, D, " "); for (i = 1; i <= nd; i++) skip[D[i]] = 1
			cur = first + 0; best = 0; bs = 0; be = 0
		}
		{
			n = $1; s = $2 + 0; e = $3 + 0
			if (n == ud) {
				if (act == "delete") next
				if (act == "shrink") e = udend + 0
			}
			if (n in skip) next
			if (s - 1 >= cur) { g = s - cur; if (g > best) { best = g; bs = cur; be = s - 1 } }
			if (e + 1 > cur) cur = e + 1
		}
		END {
			g = last - cur + 1
			if (g > best) { best = g; bs = cur; be = last }
			if (best > 0) print bs, be
		}'
}

# Math helpers with awk (safe against 32-bit shell integer overflow)
sectors_for_gb() { awk -v g="$1" -v s="$SECSZ" 'BEGIN { printf "%d", g * 1073741824 / s }'; }
sectors_for_mb() { awk -v m="$1" -v s="$SECSZ" 'BEGIN { printf "%d", (m * 1048576 + s - 1) / s }'; }
gb_of_sectors()  { awk -v n="$1" -v s="$SECSZ" 'BEGIN { printf "%d", n * s / 1073741824 }'; }

clean_size() { printf '%s' "$1" | tr -d ' \t' | tr ',' '.'; }
is_size()    { awk -v v="$1" 'BEGIN { exit !(v ~ /^[0-9]+(\.[0-9]+)?$/ && v + 0 > 0) }'; }
num_le()     { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a + 0 <= b + 0) }'; }

refresh_disk() {
	[ "$DRY_RUN" = 1 ] && return 0
	sync
	stop vendor.qseecomd >/dev/null 2>&1 || true
	blockdev --rereadpt "$DISK" >/dev/null 2>&1 || true
	partprobe "$DISK" >/dev/null 2>&1 || true
	# trigger uevent generation in sysfs
	_bname=$(basename "$DISK")
	[ -e "/sys/block/$_bname/uevent" ] && echo add > "/sys/block/$_bname/uevent" 2>/dev/null || true
	for _ue in /sys/block/$_bname/$_bname*/uevent; do
		[ -e "$_ue" ] && echo add > "$_ue" 2>/dev/null || true
	done
	mdev -s >/dev/null 2>&1 || true
	start vendor.qseecomd >/dev/null 2>&1 || true
	sleep 1
}

run_cmd() {
	if [ "$DRY_RUN" = 1 ]; then
		echo "   [DRY-RUN] $*"
	else
		echo "   + $*"
		"$@" || die "Command failed: $*"
		refresh_disk
	fi
}

unmount_storage() {
	say ">> Unmounting existing partitions on $DISK..."
	for m in /data /sdcard /esp /linux /ubuntu_data /mnt/data; do
		umount -l "$m" >/dev/null 2>&1 || true
	done
	for p in userdata esp linux data; do
		if [ -e "$BYNAME/$p" ]; then
			DEV=$(readlink -f "$BYNAME/$p" 2>/dev/null)
			[ -b "$DEV" ] && umount -l "$DEV" >/dev/null 2>&1 || true
		fi
	done
}

refresh_byname_symlinks() {
	[ "$DRY_RUN" = 1 ] && return 0
	say ">> Refreshing by-name partition symlinks..."
	load_table
	for d in /dev/block/by-name /dev/block/bootdevice/by-name; do
		mkdir -p "$d" 2>/dev/null || true
	done
	_rows=$(table_rows)
	for p_num in $(printf '%s\n' "$_rows" | awk '{print $1}'); do
		p_name=$(printf '%s\n' "$TABLE" | awk -v p="$p_num" '$1+0 == p+0 {print $NF; exit}')
		[ -n "$p_name" ] || continue
		case "$DISK" in
			*p|*p[0-9]*) p_dev="${DISK}p${p_num}" ;;
			*)           p_dev="${DISK}${p_num}" ;;
		esac
		if [ -b "$p_dev" ]; then
			for d in /dev/block/by-name /dev/block/bootdevice/by-name "$BYNAME"; do
				[ -n "$d" ] && [ -d "$d" ] && ln -sf "$p_dev" "$d/$p_name" 2>/dev/null || true
			done
		fi
	done
}

format_device() {
	_type="$1"
	_dev="$2"
	_label="$3"

	# Wait for device node to settle
	_i=0
	while [ ! -b "$_dev" ] && [ "$_i" -lt 15 ]; do
		refresh_disk
		refresh_byname_symlinks
		sleep 0.5
		_i=$(( _i + 1 ))
	done

	if [ ! -b "$_dev" ]; then
		say "!! Device node $_dev not found for formatting."
		return 1
	fi

	case "$_type" in
		vfat)
			say ">> Formatting $_dev as FAT32 (label: $_label)..."
			if command -v mkfs.fat >/dev/null 2>&1; then
				mkfs.fat -F 32 -I -s 1 -n "$_label" "$_dev" >/dev/null 2>&1 || \
					mkfs.fat -F 32 -I -n "$_label" "$_dev" >/dev/null 2>&1
			else
				say "!! mkfs.fat not available."
				return 1
			fi
			;;
		ext4)
			say ">> Formatting $_dev as ext4 (label: $_label)..."
			if command -v mke2fs >/dev/null 2>&1; then
				mke2fs -t ext4 -b 4096 -F -L "$_label" "$_dev" >/dev/null 2>&1
			elif command -v mkfs.ext4 >/dev/null 2>&1; then
				mkfs.ext4 -F -L "$_label" "$_dev" >/dev/null 2>&1
			else
				say "!! mke2fs/mkfs.ext4 not available."
				return 1
			fi
			;;
		f2fs)
			say ">> Formatting $_dev as F2FS (label: $_label)..."
			if command -v make_f2fs >/dev/null 2>&1; then
				make_f2fs -g android "$_dev" >/dev/null 2>&1 || make_f2fs "$_dev" >/dev/null 2>&1
			elif command -v mke2fs >/dev/null 2>&1; then
				say "make_f2fs not found; falling back to ext4"
				mke2fs -t ext4 -b 4096 -F -L "$_label" "$_dev" >/dev/null 2>&1
			fi
			;;
	esac
	return 0
}

auto_mount_partitions() {
	[ "$DRY_RUN" = 1 ] && return 0
	say ">> Auto-mounting created partitions in recovery (no reboot required)..."
	refresh_byname_symlinks
	refresh_disk

	# 1. ESP
	_esp_dev="$BYNAME/esp"
	[ -e "$_esp_dev" ] || _esp_dev="/dev/block/by-name/esp"
	if [ -e "$_esp_dev" ]; then
		mkdir -p /esp
		umount /esp >/dev/null 2>&1 || true
		if mount -t vfat "$_esp_dev" /esp 2>/dev/null; then
			say "   [OK] Mounted 'esp' at /esp"
		fi
	fi

	# 2. Linux Data
	_dat_dev="$BYNAME/data"
	[ -e "$_dat_dev" ] || _dat_dev="/dev/block/by-name/data"
	if [ -e "$_dat_dev" ]; then
		mkdir -p /ubuntu_data
		umount /ubuntu_data >/dev/null 2>&1 || true
		if mount -t ext4 "$_dat_dev" /ubuntu_data 2>/dev/null; then
			say "   [OK] Mounted 'data' at /ubuntu_data"
		fi
	fi

	# 3. Linux rootfs (if already formatted ext4)
	_lin_dev="$BYNAME/linux"
	[ -e "$_lin_dev" ] || _lin_dev="/dev/block/by-name/linux"
	if [ -e "$_lin_dev" ]; then
		mkdir -p /linux
		umount /linux >/dev/null 2>&1 || true
		if mount -t ext4 "$_lin_dev" /linux 2>/dev/null; then
			say "   [OK] Mounted 'linux' at /linux"
		fi
	fi

	# 4. Userdata (Android)
	_ud_dev="$BYNAME/userdata"
	[ -e "$_ud_dev" ] || _ud_dev="/dev/block/by-name/userdata"
	if [ -e "$_ud_dev" ]; then
		mkdir -p /data
		umount /data >/dev/null 2>&1 || true
		if mount -t f2fs "$_ud_dev" /data 2>/dev/null || mount -t ext4 "$_ud_dev" /data 2>/dev/null; then
			say "   [OK] Mounted 'userdata' at /data"
			mkdir -p /data/media/0 /sdcard 2>/dev/null || true
			mount -o bind /data/media/0 /sdcard 2>/dev/null || true
		fi
	fi
}

show_layout() {
	load_table
	say "========================================================================="
	say "Current disk layout ($DISK):"
	say "-------------------------------------------------------------------------"
	min_slot="${UD_NUM}"
	if [ -z "$min_slot" ]; then
		super_n=$(part_num_by_name super)
		min_slot="${super_n:-14}"
	fi
	sgdisk --print "$DISK" 2>/dev/null | awk -v min="$min_slot" '
		$1 == "Number" && $2 == "Start" { header = 1; print; next }
		header && $1 ~ /^[0-9]+$/ && $1+0 < min+0 { next }
		header { print }
	'
	[ -n "$min_slot" ] && [ "$min_slot" -gt 1 ] 2>/dev/null && \
		say "   (stock firmware partitions 1..$((min_slot-1)) hidden)"
	say "========================================================================="
}

# -----------------------------------------------------------------------------
# Automated Actions (Called via CLI or Recovery GUI)
# -----------------------------------------------------------------------------

apply_dualboot() {
	say "=== Executing Dual-Boot Partitioning (Android + Linux) ==="
	say "Configuration:"
	say "  Android Userdata : ${USERDATA_GB} GB"
	say "  ESP              : ${ESP_SIZE_MB} MB (fixed FAT32)"
	say "  Linux Root       : ${LINUX_GB} GB"
	say "  Linux Data       : ${DATA_GB}"

	unmount_storage

	# 1. Clean existing target partitions
	for p in data linux1 linux esp; do
		n=$(part_num_by_name "$p")
		[ -n "$n" ] && run_cmd sgdisk --delete="$n" "$DISK"
	done
	refresh_disk

	# 2. Userdata start & shrink
	SUPER_N=$(part_num_by_name super)
	if [ -n "$SUPER_N" ]; then
		SUPER_END=$(part_last_sector "$SUPER_N")
		UD_START=$(( SUPER_END + 1 ))
		_R=$(( UD_START % 8 ))
		[ "$_R" -ne 0 ] && UD_START=$(( UD_START + 8 - _R ))
	else
		UD_START=3228640
	fi

	n=$(part_num_by_name userdata)
	if [ -n "$n" ]; then
		UD_NUM="$n"
		run_cmd sgdisk --delete="$UD_NUM" "$DISK"
	else
		UD_NUM=15
	fi

	LAST_USABLE=$(last_usable_sector)
	_USECT=$(sectors_for_gb "$USERDATA_GB")
	NEW_UD_END=$(( UD_START + _USECT - 1 ))
	NEW_UD_END=$(( NEW_UD_END - NEW_UD_END % 8 ))
	[ "$NEW_UD_END" -lt "$LAST_USABLE" ] || die "Userdata size exceeds disk capacity."

	say ">> Creating 'userdata' (part $UD_NUM): $UD_START..$NEW_UD_END (${USERDATA_GB} GB)"
	run_cmd sgdisk --new="$UD_NUM:$UD_START:$NEW_UD_END" \
	                --change-name="$UD_NUM:userdata" \
	                --typecode="$UD_NUM:8300" "$DISK"

	# 3. Create ESP
	ESP_START=$(( NEW_UD_END + 1 ))
	_R=$(( ESP_START % 8 )); [ "$_R" -ne 0 ] && ESP_START=$(( ESP_START + 8 - _R ))
	ESP_SECT=$(sectors_for_mb "$ESP_SIZE_MB")
	ESP_END=$(( ESP_START + ESP_SECT - 1 ))
	[ "$ESP_END" -lt "$LAST_USABLE" ] || die "ESP does not fit in remaining space."

	ESP_NUM=$(( UD_NUM + 1 ))
	say ">> Creating 'esp' (part $ESP_NUM): $ESP_START..$ESP_END (${ESP_SIZE_MB} MB)"
	run_cmd sgdisk --new="$ESP_NUM:$ESP_START:$ESP_END" \
	                --change-name="$ESP_NUM:esp" \
	                --typecode="$ESP_NUM:ef00" "$DISK"

	# 4. Create Linux root
	LIN_START=$(( ESP_END + 1 ))
	_R=$(( LIN_START % 8 )); [ "$_R" -ne 0 ] && LIN_START=$(( LIN_START + 8 - _R ))
	LIN_NUM=$(( ESP_NUM + 1 ))

	if [ "$LINUX_GB" = "all" ]; then
		LIN_END=$LAST_USABLE
		say ">> Creating 'linux' (part $LIN_NUM): $LIN_START..$LIN_END (remaining disk)"
	else
		_LSECT=$(sectors_for_gb "$LINUX_GB")
		LIN_END=$(( LIN_START + _LSECT - 1 ))
		[ "$LIN_END" -le "$LAST_USABLE" ] || die "Linux partition exceeds remaining space."
		say ">> Creating 'linux' (part $LIN_NUM): $LIN_START..$LIN_END (${LINUX_GB} GB)"
	fi
	run_cmd sgdisk --new="$LIN_NUM:$LIN_START:$LIN_END" \
	                --change-name="$LIN_NUM:linux" \
	                --typecode="$LIN_NUM:8300" "$DISK"

	# 5. Create Data (Linux extra / storage)
	HAS_DATA=0
	if [ "$LIN_END" -lt "$LAST_USABLE" ] && [ "$DATA_GB" != "none" ]; then
		DAT_START=$(( LIN_END + 1 ))
		_R=$(( DAT_START % 8 )); [ "$_R" -ne 0 ] && DAT_START=$(( DAT_START + 8 - _R ))
		DAT_NUM=$(( LIN_NUM + 1 ))

		if [ "$DATA_GB" = "all" ]; then
			DAT_END=$LAST_USABLE
			say ">> Creating 'data' (part $DAT_NUM): $DAT_START..$DAT_END (remaining disk)"
		else
			_DSECT=$(sectors_for_gb "$DATA_GB")
			DAT_END=$(( DAT_START + _DSECT - 1 ))
			[ "$DAT_END" -gt "$LAST_USABLE" ] && DAT_END=$LAST_USABLE
			say ">> Creating 'data' (part $DAT_NUM): $DAT_START..$DAT_END (${DATA_GB} GB)"
		fi
		run_cmd sgdisk --new="$DAT_NUM:$DAT_START:$DAT_END" \
		                --change-name="$DAT_NUM:data" \
		                --typecode="$DAT_NUM:8300" "$DISK"
		HAS_DATA=1
	fi

	# 6. Commit GPT
	say ">> Relocating backup GPT to end of disk..."
	run_cmd sgdisk --move-second-header "$DISK"
	refresh_disk

	if [ "$DRY_RUN" = 1 ]; then
		say "Dry run complete. No modifications were written to disk."
		return 0
	fi

	# 7. Format partitions
	format_device vfat "$BYNAME/esp" "ERHAI_ESP"
	if [ "$HAS_DATA" = 1 ]; then
		format_device ext4 "$BYNAME/data" "data"
	fi
	if [ "$FORMAT_USERDATA" = 1 ]; then
		format_device f2fs "$BYNAME/userdata" "userdata"
	fi

	# 8. Auto-mount without reboot
	auto_mount_partitions

	say "========================================================================="
	say "Dual-Boot partitioning completed and auto-mounted successfully!"
	say "========================================================================="
}

apply_linux_only() {
	say "=== Executing Linux-Only Partitioning ==="
	say "Configuration:"
	say "  ESP          : ${ESP_SIZE_MB} MB"
	say "  Linux Root   : ${LINUX_GB} GB"
	say "  Linux Data   : ${DATA_GB}"

	unmount_storage

	# 1. Delete Android and old Linux partitions
	for p in data linux1 linux esp userdata; do
		n=$(part_num_by_name "$p")
		[ -n "$n" ] && run_cmd sgdisk --delete="$n" "$DISK"
	done
	refresh_disk

	SUPER_N=$(part_num_by_name super)
	if [ -n "$SUPER_N" ]; then
		SUPER_END=$(part_last_sector "$SUPER_N")
		UD_START=$(( SUPER_END + 1 ))
		_R=$(( UD_START % 8 ))
		[ "$_R" -ne 0 ] && UD_START=$(( UD_START + 8 - _R ))
	else
		UD_START=3228640
	fi
	LAST_USABLE=$(last_usable_sector)

	# 2. Create ESP at start of free space
	ESP_START=$UD_START
	ESP_SECT=$(sectors_for_mb "$ESP_SIZE_MB")
	ESP_END=$(( ESP_START + ESP_SECT - 1 ))
	ESP_NUM=15

	say ">> Creating 'esp' (part $ESP_NUM): $ESP_START..$ESP_END (${ESP_SIZE_MB} MB)"
	run_cmd sgdisk --new="$ESP_NUM:$ESP_START:$ESP_END" \
	                --change-name="$ESP_NUM:esp" \
	                --typecode="$ESP_NUM:ef00" "$DISK"

	# 3. Create Linux root
	LIN_START=$(( ESP_END + 1 ))
	_R=$(( LIN_START % 8 )); [ "$_R" -ne 0 ] && LIN_START=$(( LIN_START + 8 - _R ))
	LIN_NUM=$(( ESP_NUM + 1 ))

	if [ "$LINUX_GB" = "all" ]; then
		LIN_END=$LAST_USABLE
		say ">> Creating 'linux' (part $LIN_NUM): $LIN_START..$LIN_END (remaining disk)"
	else
		_LSECT=$(sectors_for_gb "$LINUX_GB")
		LIN_END=$(( LIN_START + _LSECT - 1 ))
		[ "$LIN_END" -le "$LAST_USABLE" ] || die "Linux partition exceeds disk capacity."
		say ">> Creating 'linux' (part $LIN_NUM): $LIN_START..$LIN_END (${LINUX_GB} GB)"
	fi
	run_cmd sgdisk --new="$LIN_NUM:$LIN_START:$LIN_END" \
	                --change-name="$LIN_NUM:linux" \
	                --typecode="$LIN_NUM:8300" "$DISK"

	# 4. Create Data if remaining space
	HAS_DATA=0
	if [ "$LIN_END" -lt "$LAST_USABLE" ] && [ "$DATA_GB" != "none" ]; then
		DAT_START=$(( LIN_END + 1 ))
		_R=$(( DAT_START % 8 )); [ "$_R" -ne 0 ] && DAT_START=$(( DAT_START + 8 - _R ))
		DAT_NUM=$(( LIN_NUM + 1 ))

		if [ "$DATA_GB" = "all" ]; then
			DAT_END=$LAST_USABLE
			say ">> Creating 'data' (part $DAT_NUM): $DAT_START..$DAT_END (remaining disk)"
		else
			_DSECT=$(sectors_for_gb "$DATA_GB")
			DAT_END=$(( DAT_START + _DSECT - 1 ))
			[ "$DAT_END" -gt "$LAST_USABLE" ] && DAT_END=$LAST_USABLE
			say ">> Creating 'data' (part $DAT_NUM): $DAT_START..$DAT_END (${DATA_GB} GB)"
		fi
		run_cmd sgdisk --new="$DAT_NUM:$DAT_START:$DAT_END" \
		                --change-name="$DAT_NUM:data" \
		                --typecode="$DAT_NUM:8300" "$DISK"
		HAS_DATA=1
	fi

	# 5. Commit GPT
	say ">> Relocating backup GPT..."
	run_cmd sgdisk --move-second-header "$DISK"
	refresh_disk

	if [ "$DRY_RUN" = 1 ]; then
		say "Dry run complete. No modifications were written to disk."
		return 0
	fi

	# 6. Format partitions
	format_device vfat "$BYNAME/esp" "ERHAI_ESP"
	if [ "$HAS_DATA" = 1 ]; then
		format_device ext4 "$BYNAME/data" "data"
	fi

	# 7. Auto-mount without reboot
	auto_mount_partitions

	say "========================================================================="
	say "Linux-Only partitioning completed and auto-mounted successfully!"
	say "========================================================================="
}

apply_android_only() {
	say "=== Executing Android-Only Restore ==="
	say "Restoring single continuous userdata partition..."

	unmount_storage

	# 1. Delete all Linux partitions and existing userdata
	for p in data linux1 linux esp userdata; do
		n=$(part_num_by_name "$p")
		[ -n "$n" ] && run_cmd sgdisk --delete="$n" "$DISK"
	done
	refresh_disk

	SUPER_N=$(part_num_by_name super)
	if [ -n "$SUPER_N" ]; then
		SUPER_END=$(part_last_sector "$SUPER_N")
		UD_START=$(( SUPER_END + 1 ))
		_R=$(( UD_START % 8 ))
		[ "$_R" -ne 0 ] && UD_START=$(( UD_START + 8 - _R ))
	else
		UD_START=3228640
	fi
	UD_NUM=15

	# 2. Create single full userdata from after super to end of disk
	say ">> Creating full 'userdata' (part $UD_NUM): $UD_START..end of disk"
	run_cmd sgdisk --new="$UD_NUM:$UD_START:0" \
	                --change-name="$UD_NUM:userdata" \
	                --typecode="$UD_NUM:8300" "$DISK"

	# 3. Commit GPT
	say ">> Relocating backup GPT..."
	run_cmd sgdisk --move-second-header "$DISK"
	refresh_disk

	if [ "$DRY_RUN" = 1 ]; then
		say "Dry run complete. No modifications were written to disk."
		return 0
	fi

	# 4. Format userdata as F2FS
	format_device f2fs "$BYNAME/userdata" "userdata"

	# 5. Auto-mount without reboot
	auto_mount_partitions

	say "========================================================================="
	say "Android-Only restore completed and auto-mounted successfully!"
	say "========================================================================="
}

# -----------------------------------------------------------------------------
# Interactive Menu (Mirroring erhai-setup_partitions.sh v1.2)
# -----------------------------------------------------------------------------

interactive_menu() {
	clear 2>/dev/null || true
	say ""
	say "======================================================================="
	say "        OnePlus Pad 3 (erhai) — Linux partitioning utility"
	say "                          by TheMojoMan"
	say "======================================================================="
	say ""
	say " disk       : $DISK   (sector size ${SECSZ} B)"
	if [ -n "$UD_NUM" ]; then
		say " userdata   : partition $UD_NUM"
	else
		say " userdata   : NOT FOUND — Android's data partition is missing"
	fi
	say ""
	say " !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
	say " !! Android need to be reinstalled after size of userdata is changed !!"
	say " !!             Backup all your data BEFORE proceeding               !!"
	say " !!                                                                  !!"
	say " !!         Press Ctrl + C at any time to cancel this setup          !!"
	say " !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
	say ""
	say "Please choose:"
	say " 1. Dry-run mode    -  simulates the setup, writes nothing yet"
	say " 2. Execution mode  -  alters the disk layout - DANGEROUS!"
	printf "Selection [1/2, default 1]: "
	read -r d
	if [ "$d" = "2" ]; then
		DRY_RUN=0
		say ""
		say " *** DRY RUN IS OFF. Changes will be written to $DISK. ***"
	else
		DRY_RUN=1
		say ""
		say " Dry-run is ON — commands are printed, not executed."
	fi

	show_layout

	say "  1) Partition disk for LINUX"
	say "  2) Restore ANDROID layout"
	say "  3) Auto-mount partitions now (without partitioning)"
	say "  4) Quit"
	printf "Select [1/2/3/4]: "
	read -r m

	case "$m" in
		1)
			CLEAN_LIST="esp linux data"
			[ "$DEV_MODE" = 1 ] && CLEAN_LIST="esp linux linux1 data"
			DELETED=""
			for p in $CLEAN_LIST; do
				n=$(part_num_by_name "$p")
				if [ -n "$n" ]; then
					say ""
					say "A partition named '$p' already exists (number $n)."
					if confirm "Delete it"; then
						run_cmd sgdisk --delete="$n" "$DISK"
						DELETED="$DELETED $n"
					fi
				fi
			done
			refresh_disk

			UD_ACTION="keep"
			UD_END_NEW=0
			if [ -z "$UD_NUM" ] || [ -z "$(part_first_sector "$UD_NUM")" ]; then
				say "No 'userdata' partition — Android's data is already gone."
				UD_ACTION="delete"
			else
				UD_START=$(part_first_sector "$UD_NUM")
				UD_END=$(part_last_sector "$UD_NUM")
				UD_SIZE_GB=$(gb_of_sectors $((UD_END - UD_START + 1)))
				say ""
				say "userdata is partition $UD_NUM, ${UD_SIZE_GB} GB"
				say "  1) Shrink userdata, keep Android         [dual boot]"
				say "  2) Delete userdata, remove Android       [Linux only]"
				say "  3) Don't touch userdata                  [re-partition / testing]"
				printf "Choice [1/2/3]: "
				read -r c
				case "$c" in
					1)
						printf "New userdata size in GB [default 64]: "
						read -r nsz
						[ -z "$nsz" ] && nsz=64
						nsz=$(clean_size "$nsz")
						USERDATA_GB="$nsz"
						_USECT=$(sectors_for_gb "$nsz")
						UD_END_NEW=$(( UD_START + _USECT - 1 ))
						UD_END_NEW=$(( UD_END_NEW - UD_END_NEW % 8 ))
						run_cmd sgdisk --delete="$UD_NUM" "$DISK"
						run_cmd sgdisk --new="$UD_NUM:$UD_START:$UD_END_NEW" \
						                --change-name="$UD_NUM:userdata" \
						                --typecode="$UD_NUM:8300" "$DISK"
						UD_ACTION="shrink"
						;;
					2)
						confirm "Really delete Android's userdata" && {
							run_cmd sgdisk --delete="$UD_NUM" "$DISK"
							DELETED="$DELETED $UD_NUM"
							UD_ACTION="delete"
						}
						;;
					*) ;;
				esac
			fi
			refresh_disk

			FIRST=$(first_usable_sector)
			LAST=$(last_usable_sector)
			set -- $(plan_gap "$DELETED" "${UD_NUM:-0}" "$UD_ACTION" "$UD_END_NEW" "$FIRST" "$LAST")
			GAP_START=$1
			GAP_END=$2
			_R=$(( GAP_START % 8 ))
			[ "$_R" -ne 0 ] && GAP_START=$(( GAP_START + 8 - _R ))

			ESP_SECT=$(sectors_for_mb "$ESP_SIZE_MB")
			ESP_END=$(( GAP_START + ESP_SECT - 1 ))
			ESP_N=$(next_slot "$DELETED" "${UD_NUM:-14}")
			CUR=$ESP_N
			run_cmd sgdisk --new="$ESP_N:$GAP_START:$ESP_END" \
			                --change-name="$ESP_N:esp" --typecode="$ESP_N:ef00" "$DISK"
			GAP_START=$(( ESP_END + 1 ))

			printf "Linux root size in GB, or 'all' [default 40]: "
			read -r lsz
			[ -z "$lsz" ] && lsz=40
			LIN_N=$(next_slot "$DELETED" "$CUR")
			CUR=$LIN_N
			if [ "$lsz" = "all" ]; then
				LIN_END=$GAP_END
			else
				_LSECT=$(sectors_for_gb "$(clean_size "$lsz")")
				LIN_END=$(( GAP_START + _LSECT - 1 ))
			fi
			run_cmd sgdisk --new="$LIN_N:$GAP_START:$LIN_END" \
			                --change-name="$LIN_N:linux" --typecode="$LIN_N:8300" "$DISK"
			GAP_START=$(( LIN_END + 1 ))

			GAP_LEFT_GB=$(gb_of_sectors $((GAP_END - GAP_START + 1)))
			if [ "$GAP_LEFT_GB" -gt 0 ]; then
				if confirm "Create a separate 'data' partition with the rest (${GAP_LEFT_GB} GB)"; then
					DAT_N=$(next_slot "$DELETED" "$CUR")
					run_cmd sgdisk --new="$DAT_N:$GAP_START:$GAP_END" \
					                --change-name="$DAT_N:data" --typecode="$DAT_N:8300" "$DISK"
					DATA_MADE=1
				fi
			fi

			run_cmd sgdisk --move-second-header "$DISK"
			refresh_disk
			show_layout

			if [ "$DRY_RUN" = 0 ]; then
				format_device vfat "$BYNAME/esp" "ERHAI_ESP"
				[ "${DATA_MADE:-0}" = 1 ] && format_device ext4 "$BYNAME/data" "data"
				[ "$UD_ACTION" = "shrink" ] && format_device f2fs "$BYNAME/userdata" "userdata"
				auto_mount_partitions
			fi
			;;
		2)
			apply_android_only
			;;
		3)
			auto_mount_partitions
			;;
		*)
			say "Bye."
			exit 0
			;;
	esac
}

# -----------------------------------------------------------------------------
# Main Entry Point
# -----------------------------------------------------------------------------

need_tool() {
	command -v "$1" >/dev/null 2>&1 || die "Required tool '$1' not found."
}

need_tool sgdisk
need_tool awk

for _a in "$@"; do
	[ "$_a" = "--dev" ] && DEV_MODE=1
done

find_disk

while [ $# -gt 0 ]; do
	case "$1" in
		--mode)
			MODE="$2"; shift 2 ;;
		--userdata)
			USERDATA_GB="$2"; shift 2 ;;
		--linux)
			LINUX_GB="$2"; shift 2 ;;
		--data)
			DATA_GB="$2"; shift 2 ;;
		--esp)
			ESP_SIZE_MB="$2"; shift 2 ;;
		--execute)
			DRY_RUN=0; shift ;;
		--dry-run)
			DRY_RUN=1; shift ;;
		--mount|--auto-mount)
			auto_mount_partitions; exit 0 ;;
		--status)
			show_layout; exit 0 ;;
		--dev)
			DEV_MODE=1; shift ;;
		-h|--help)
			echo "Usage: $0 [options]"
			echo "  --mode <dualboot|linux|android>"
			echo "  --userdata <GB>       Android userdata size in GB (default: 64)"
			echo "  --linux <GB|all>      Linux root partition size in GB (default: 40)"
			echo "  --data <GB|all|none>  Linux data partition size (default: all)"
			echo "  --esp <MB>            ESP partition size in MB (default: 300)"
			echo "  --execute             Execute disk changes (default is dry-run)"
			echo "  --mount               Auto-mount partitions without repartitioning"
			echo "  --status              Show current GPT disk layout"
			exit 0
			;;
		*)
			shift ;;
	esac
done

if [ -z "$MODE" ]; then
	interactive_menu
else
	case "$MODE" in
		both|dualboot) apply_dualboot ;;
		linux|ubuntu)  apply_linux_only ;;
		android)       apply_android_only ;;
		*) die "Unknown mode: $MODE (must be dualboot, linux, or android)" ;;
	esac
fi
